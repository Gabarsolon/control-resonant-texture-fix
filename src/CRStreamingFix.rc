#include <winver.h>
#include "game.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION CRSF_VERSION_NUM
PRODUCTVERSION CRSF_VERSION_NUM
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Gabarsolon"
            VALUE "FileDescription", CRSF_NAME " - " CRSF_GAME " texture streaming pool fix"
            VALUE "FileVersion", CRSF_VERSION ".0"
            VALUE "InternalName", CRSF_NAME
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", CRSF_NAME ".addon64"
            VALUE "ProductName", CRSF_NAME
            VALUE "ProductVersion", CRSF_VERSION ".0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
